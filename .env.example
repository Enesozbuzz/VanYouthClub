# VanYouthClub Environment Configuration
# Copy this file to .env for local development.
# Never commit real secrets to Git.

# Application
APP_NAME=VanYouthClub
APP_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3000

# Backend
BACKEND_URL=http://localhost:5000

# Database (PostgreSQL)
# Ortam bazlı ayrı veritabanları kullanın: vanyouthclub_dev, vanyouthclub_test, vanyouthclub (prod)
# Aşağıdaki değer yalnızca bir örnektir; gerçek credential'ları .env dosyanıza yazın, asla commit etmeyin.
DATABASE_URL=postgresql://vanyouthclub:CHANGE_ME@localhost:5432/vanyouthclub_dev?schema=public

# Authentication
# Onaylanan model: sunucu tarafı oturumlar (httpOnly cookie). JWT_SECRET şu an gerekli değil.
# SESSION_SECRET=

# Social Media
INSTAGRAM_URL=https://www.instagram.com/vanyouthclub/

# Contact
CONTACT_PHONE_1=05364261930
CONTACT_PHONE_2=05441670096
