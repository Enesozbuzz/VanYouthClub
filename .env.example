# VanYouthClub Environment Configuration
# Copy this file to .env for local development.
# Never commit real secrets to Git.

# Application
APP_NAME=VanYouthClub
APP_ENV=development

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Aşağıdaki değer yalnızca bir örnektir; gerçek credential'ları .env dosyanıza yazın, asla commit etmeyin.
DATABASE_URL=postgresql://USER:CHANGE_ME@localhost:5432/vanyouthclub_dev?schema=public

# Seeded first admin account (development only — change in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Social Media
INSTAGRAM_URL=https://www.instagram.com/vanyouthclub/

# Contact
CONTACT_PHONE_1=05364261930
CONTACT_PHONE_2=05441670096
